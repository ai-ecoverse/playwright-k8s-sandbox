# shellcheck shell=bash disable=SC2034
# Latest stable upstream releases checked on 2026-10-16.
# Kubernetes: https://dl.k8s.io/release/stable.txt
# No official kindest/node:v1.37.1 image exists as of this check, so build from
# the exact Kubernetes release using the pinned kind builder when first needed.
KUBERNETES_VERSION="v1.37.1"
KIND_BUILD_VERSION="v0.33.0"
KIND_NODE_IMAGE="playwright-kind-node:${KUBERNETES_VERSION}"
AGENT_SANDBOX_VERSION="${AGENT_SANDBOX_VERSION:-v1.0.7}"
ISOLA_VERSION="${ISOLA_VERSION:-0.7.0}"
KARS_VERSION="${KARS_VERSION:-v0.1.26}"
SUBSTRATE_VERSION="${SUBSTRATE_VERSION:-v0.5.0}"
GVISOR_VERSION="${GVISOR_VERSION:-20260622}"
